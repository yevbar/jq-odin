# Root iterator compound assignments update each array element independently.
([2,4,6] | .[] += 2)
[4,6,8]

([2,4,6] | .[] -= 2)
[0,2,4]

([2,4,6] | .[] *= 2)
[4,8,12]

([2,4,6] | .[] /= 2)
[1,2,3]

([2,4,6] | .[] %= 2)
[0,0,0]

# Existing iterator assignment and deletion remain unchanged.
([2,4,6] | .[] = 9)
[9,9,9]

([2,4,6] | .[] |= empty)
[]

# Numeric failures remain catchable and retain jq's diagnostic text.
try ([1,0] | .[] /= 0) catch .
"number (1) and number (0) cannot be divided because the divisor is zero"

try ([1,0] | .[] %= 0) catch .
"number (1) and number (0) cannot be divided (remainder) because the divisor is zero"

try ({a:1,b:2} | .[] /= 0) catch .
"number (1) and number (0) cannot be divided because the divisor is zero"

try ({a:1,b:2} | .[] %= 0) catch .
"number (1) and number (0) cannot be divided (remainder) because the divisor is zero"
