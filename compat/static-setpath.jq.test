# Literal path replacement at the root.
setpath(["a"]; 1)
{"a":0}
{"a":1}

# Literal nested object path replacement.
setpath(["a","b"]; 1)
{"a":{"b":0}}
{"a":{"b":1}}

# Literal mixed array/object path replacement.
setpath([0,"a"]; 2)
[{"a":0}]
[{"a":2}]

# An empty path replaces the root value.
setpath([]; 3)
{"a":0}
3
