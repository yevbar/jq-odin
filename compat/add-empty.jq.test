# Generator-valued add accepts an empty child stream and returns null.
add(empty)
null

1 | add(empty)
null

add(range(3))
3

add(range(1;4))
6

3 | add(range(.))
3

0 | add(range(.))
null

[1,2] | add(.[])
3

3 | add((range(3)))
3

null | add([1,2])
[1,2]

add(null)
null

[1,2] | add(map(. + 1))
[2,3]

{"a":1,"b":2} | add(.[])
3

3 | add(range(1;.))
3

3 | add(range(.;5))
7

3 | add(range(0;.;2))
2

add(10,range(10))
55

add(empty,range(3))
3

add(range(2),range(2))
2

add(range(range(3)))
1

add(range(range(10)))
120
