# Direct object destructuring binds named fields.
. as {a:$x} | $x
{"a":7,"b":9}
7

. as {a:$x,b:$y} | [$x,$y]
{"a":7,"b":9}
[7,9]

# Missing object fields bind null, as in ordinary jq field access.
. as {a:$x,b:$y} | [$x,$y]
{}
[null,null]

# Iterator-fed object patterns preserve missing-field nulls per item.
.[] as {a:$x} | $x
[{"a":1},{"b":2},{"a":3,"b":4}]
1
null
3
