# Dynamic trimstr separators come from the binding stream and preserve the
# surrounding try/catch body for each produced pair.
.[] as [$x, $y] | try ["ok", ($x | ltrimstr($y))] catch ["err", .]
[["foobar", "foo"], ["bar", "foo"]]
["ok", "bar"]
["ok", "bar"]

.[] as [$x, $y] | try ["ok", ($x | rtrimstr($y))] catch ["err", .]
[["foobar", "bar"], ["barfoo", "foo"]]
["ok", "foobar"]
["ok", "bar"]

# A dynamic separator is a generator; each string result produces one output.
"foobar" | ltrimstr(("f", "b"))
"oobar"
"foobar"

# Non-string inputs retain the builtin's typed error through a dynamic child.
.[] as [$x, $y] | try ["ok", ($x | ltrimstr($y))] catch ["ko", .]
[["hi",1],[1,"hi"],["hi","hi"],[1,1]]
["ko","startswith() requires string inputs"]
["ko","startswith() requires string inputs"]
["ok",""]
["ko","startswith() requires string inputs"]

.[] as [$x, $y] | try ["ok", ($x | rtrimstr($y))] catch ["ko", .]
[["hi",1],[1,"hi"],["hi","hi"],[1,1]]
["ko","endswith() requires string inputs"]
["ko","endswith() requires string inputs"]
["ok",""]
["ko","endswith() requires string inputs"]
