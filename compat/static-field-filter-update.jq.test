# Root static-field filter updates consume the first RHS result.
.foo |= .+1
{"foo":2,"bar":9}
{"foo":3,"bar":9}

.foo |= .+1
{}
{"foo":1}

.foo |= .+1
null
{"foo":1}

.foo |= (1,2)
{"foo":2,"bar":9}
{"foo":1,"bar":9}

.foo |= empty
{"foo":2,"bar":9}
{"bar":9}

.foo |= (empty,3)
{"foo":2,"bar":9}
{"foo":3,"bar":9}

.foo |= (1,2/0)
{"foo":2}
{"foo":1}

try (.foo |= (empty,2/0)) catch .
{"foo":2}
"number (2) and number (0) cannot be divided because the divisor is zero"

try (.foo |= .+1) catch .
1
"Cannot index number with string \"foo\""
