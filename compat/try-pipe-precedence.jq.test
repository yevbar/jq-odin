# A pipe after a comma applies to the complete comma stream, including catches.
try ltrimstr("x") catch "x", try rtrimstr("x") catch "x" | "ok"
null
"ok"
"ok"

# A comma after catch starts the surrounding stream, not the catch filter.
try trim catch ., try ltrim catch ., try rtrim catch .
123
"trim input must be a string"
"trim input must be a string"
"trim input must be a string"
