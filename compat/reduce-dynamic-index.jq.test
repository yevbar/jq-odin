# Bounded dynamic-index reducer: the bound variable is retained as both key
# and replacement while the accumulator grows with jq's null-fill semantics.
reduce range(3;0;-1) as $i ([]; .[$i] = $i)
null
[null,1,2,3]

reduce range(3;0;-1) as $i (null; .[$i] = $i)
null
[null,1,2,3]

reduce range(65540;65536;-1) as $i ([]; .[$i] = $i)|.[65536:]
null
[null,65537,65538,65539,65540]
