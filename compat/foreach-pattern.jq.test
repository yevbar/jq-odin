# Foreach generator destructuring binds array slots into the update filter.
([ [2,1], [5,3], [6,4] ] | [foreach .[] as [$i, $j] (0; . + $i - $j)])
null
[1,3,5]

# Object patterns bind a missing field to null, matching jq's null arithmetic
# identity in this bounded accumulator form.
([ {a:1}, {b:2}, {a:3,b:4} ] | [foreach .[] as {a:$a} (0; . + $a; -.)])
null
[-1,-1,-4]

# A three-clause extractor remains available with a destructured generator.
([ [2,1], [5,3] ] | [foreach .[] as [$i,$j] (0; . + $i - $j; .)])
null
[1,3]
