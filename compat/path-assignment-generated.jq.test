# Bounded generated-path assignment evaluates RHS once and applies each path.
.[1,2] = 10
[0,1,2]
[0,10,10]

def x: .[1,2]; x=10
[0,1,2]
[0,10,10]

.[1,2] = (1,2)
[0,0,0]
[0,1,1]
[0,2,2]

.[1,2] = empty
[0,0,0]

try (1 | .[1,2] = 10) catch .
1
"Cannot index number with number"

try ({} | .[1,2] = 10) catch .
{}
"Cannot index object with number"

.[1,2] = 10
null
[null,10,10]

# A generated path filter that yields an array result is rejected as an
# assignment path with jq's result-bearing diagnostic.
try (def x: reverse; x=10) catch .
[0,1,2]
"Invalid path expression with result [2,1,0]"

try (def x: ["a"]; x=10) catch .
{}
"Invalid path expression with result [\"a\"]"

try (def x: 1; x=10) catch .
{}
"Invalid path expression with result 1"
