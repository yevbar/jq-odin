# Root iterator update evaluates the RHS independently for each element.
[1,"3",6.7,"bad",0.89,-876,5.43,21] | .[] |= try tonumber
[1,3,6.7,0.89,-876,5.43,21]

# An empty RHS result deletes only that element and resumes at the shifted index.
["bad","4","also bad"] | .[] |= try tonumber
[4]

# Object value iterators preserve keys while applying the same continuation.
{"a":"1","b":"bad","c":2} | .[] |= try tonumber
{"a":1,"c":2}
