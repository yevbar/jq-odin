# Exact jq.test:929 recursive destructuring alternation.
.[] | . as {$a, b: [$c, {$d}]} ?// [$a, {$b}, $e] ?// $f | [$a, $b, $c, $d, $e, $f]
[{"a":1,"b":[2,{"d":3}]},[4,{"b":5,"c":6},7,8,9],"foo"]
[1,null,2,3,null,null]
[4,5,null,null,7,null]
[null,null,null,null,null,"foo"]

# Null/missing fields initialize every capture to null, matching jq.
. as {$a, b: [$c, {$d}]} ?// [$a, {$b}, $e] ?// $f | [$a, $b, $c, $d, $e, $f]
null
[null,null,null,null,null,null]

. as {$a, b: [$c, {$d}]} ?// [$a, {$b}, $e] ?// $f | [$a, $b, $c, $d, $e, $f]
{"a":1,"b":[2]}
[1,null,2,null,null,null]

# Strict shape guard leaves ordinary alternations on their existing ABI.
. as [$a] ?// [$b] | .
[]
[]
