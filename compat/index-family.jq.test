# ASCII literal index/rindex/indices search.
[(index(","), rindex(",")), indices(",")]
"a,bc,def,ghij,klmno"
[1,13,[1,4,8,13]]

[ index("aba"), rindex("aba"), indices("aba") ]
"xababababax"
[1,7,[1,3,5,7]]

indices(", ")
"a,b, cd,e, fgh, ijkl"
[3,9,14]

# Null and array inputs: null propagates; arrays compare exact string elements.
[index("a"), rindex("a"), indices("a")]
null
[null, null, null]

[index("a"), rindex("a"), indices("a")]
[]
[null, null, []]

[index("a"), rindex("a"), indices("a")]
[1, "a", null, "a"]
[1, 3, [1, 3]]

[index("a"), rindex("a"), indices("a")]
["ba", "a", "c"]
[1, 1, [1]]

# Unicode input reports code-point indexes (not UTF-8 byte offsets).
index("!")
"здравствуй мир!"
14

indices("o")
"🇬🇧oo"
[2, 3]

indices("o")
"ƒoo"
[1, 2]

# Literal comma-separated needles produce one result per needle.
[(index(",","|"), rindex(",","|")), indices(",","|")]
"a,b|c,d,e||f,g,h,|,|,i,j"
[1,3,22,19,[1,5,7,12,14,16,18,20,22],[3,9,10,17,19]]
