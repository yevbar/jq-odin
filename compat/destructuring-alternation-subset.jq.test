# Bounded same-name destructuring alternation, covering jq.test:952/959.
.[] | . as {a:$a} ?// {a:$a} ?// $a | [$a, type, .]
[{"a":1},[2],{"b":3},4,null]
[1,"object",{"a":1}]
[[2],"array",[2]]
[null,"object",{"b":3}]
[4,"number",4]
[null,"null",null]

# Three repeated object alternatives, covering jq.test:936/940/944/948.
try (.[] | . as {a:$a} ?// {a:$a} ?// {a:$a} | $a) catch .
[[3],[4],[5],6]
"Cannot index array with string \"a\""
"Cannot index array with string \"a\""
"Cannot index array with string \"a\""
"Cannot index number with string \"a\""

try (.[] as {a:$a} ?// {a:$a} ?// {a:$a} | $a) catch .
[[3],[4],[5],6]
"Cannot index array with string \"a\""

try ([[3],[4],[5],6][] | . as {a:$a} ?// {a:$a} ?// {a:$a} | $a) catch .
null
"Cannot index array with string \"a\""

try ([[3],[4],[5],6] | .[] as {a:$a} ?// {a:$a} ?// {a:$a} | $a) catch .
null
"Cannot index array with string \"a\""

# Scalar-first exact upstream permutations jq.test:1008/1015/1022/1029.
.[] | . as $a ?// {a:$a} ?// {a:$a} | $a
[[3],[4],[5],6]
[3]
[4]
[5]
6

.[] as $a ?// {a:$a} ?// {a:$a} | $a
[[3],[4],[5],6]
[3]
[4]
[5]
6

[[3],[4],[5],6][] | . as $a ?// {a:$a} ?// {a:$a} | $a
null
null
[3]
[4]
[5]
6

[[3],[4],[5],6] | .[] as $a ?// {a:$a} ?// {a:$a} | $a
null
null
[3]
[4]
[5]
6

# Exact upstream permutation jq.test:980.
.[] | . as {a:$a} ?// $a ?// {a:$a} | $a
[[3],[4],[5],6]
[3]
[4]
[5]
6

# Exact upstream permutation jq.test:987.
.[] as {a:$a} ?// $a ?// {a:$a} | $a
[[3],[4],[5],6]
[3]
[4]
[5]
6

# Exact upstream permutation jq.test:994.
[[3],[4],[5],6][] | . as {a:$a} ?// $a ?// {a:$a} | $a
null
[3]
[4]
[5]
6

# Exact upstream permutation jq.test:1001.
[[3],[4],[5],6] | .[] as {a:$a} ?// $a ?// {a:$a} | $a
null
[3]
[4]
[5]
6

# Pattern mismatch errors are caught before the shared body runs.
. as {a:$a} ?// {a:$a} ?// $a | (1, error("body"))
{"a":1}
1

# Object, scalar, object branch order, covering jq.test:980/987/994/1001.
.[] | . as {a:$a} ?// $a ?// {a:$a} | [$a, type, .]
[{"a":1}, [2], {"b":3}, 4, null]
[1,"object",{"a":1}]
[[2],"array",[2]]
[null,"object",{"b":3}]
[4,"number",4]
[null,"null",null]
