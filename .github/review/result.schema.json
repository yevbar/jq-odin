{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium"]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "failure_mode": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "path",
          "line",
          "title",
          "evidence",
          "failure_mode"
        ]
      }
    }
  },
  "required": ["verdict", "summary", "findings"]
}
