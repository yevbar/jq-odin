{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recommendation": {
      "type": "string",
      "enum": ["merge_as_is", "task_agent"]
    },
    "quality_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium"]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "failure_mode": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "path",
          "line",
          "title",
          "evidence",
          "failure_mode"
        ]
      }
    }
  },
  "required": [
    "recommendation",
    "quality_score",
    "confidence",
    "summary",
    "findings"
  ]
}
